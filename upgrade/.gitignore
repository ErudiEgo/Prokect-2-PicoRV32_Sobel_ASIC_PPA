# Local allowlist overrides the parent allowlist without editing stage1.
*
!*/
!/.gitignore
!/.gitattributes
!/*.md
!/stage2.json
!/rtl/*.v
!/tb/*.sv
!/scripts/*.py
!/scripts/*.sh
!/firmware/*.c
!/firmware/*.S
!/firmware/*.ld
!/firmware/generated/*.hex
!/firmware/generated/manifest.json
!/third_party/picorv32/*
!/baseline/import_manifest.json
!/baseline/stage1_import.zip
!/inputs/demo/*
!/inputs/rgb_smoke32_v1/*
!/inputs/rgb_partial17x19_v1/*
!/inputs/shapes32_00_01/*
!/inputs/shapes32_01_01/*
!/inputs/shapes64_00_01/*
!/inputs/shapes64_01_01/*
/build/
/reports/
/runs/
**/__pycache__/
**/*.pyc

!/firmware/s1/*.c
!/firmware/s1/*.h
!/firmware/s1/generated/*.hex
!/firmware/s1/generated/manifest.json
!/inputs/m2_*/*
!/firmware/s1/generated/build_evidence.zip

!/candidate/*.v
!/candidate/*.sv

!/firmware/h2/*.c
!/firmware/h2/generated/*.hex
!/firmware/h2/generated/manifest.json
!/firmware/h2/generated/build_evidence.zip

!/inputs/h2_char_*/*

!/physical/**
/run_inputs/
/physical/**/__pycache__/
/physical/**/*.pyc
