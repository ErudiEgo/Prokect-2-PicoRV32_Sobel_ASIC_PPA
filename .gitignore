# Allowlist: keep only development sources and reproducible small inputs.
# Ignored files remain on disk. Add an exception when adding a new source type.
*
!*/

# Project instructions, architecture, run guides and diagnostic history.
!/*.md
!/.gitignore
!/.gitattributes
!/config.json
!/constraints.sdc
!/pin_order.cfg

# Synthesizable RTL and simulation testbenches.
!/rtl/*.v
!/rtl/*.sv
!/rtl/*.vh
!/rtl/*.svh
!/tb/*.v
!/tb/*.sv
!/tb/*.vh
!/tb/*.svh

# Flow tooling, static checks, evidence collectors and replay.
!/scripts/*.py
!/scripts/*.sh
!/scripts/*.tcl
!/scripts/upstream_lint_review.json

# Firmware sources plus the small, verified prebuilt images.
!/firmware/*.c
!/firmware/*.h
!/firmware/*.S
!/firmware/*.ld
!/firmware/generated/sw.hex
!/firmware/generated/hw.hex
!/firmware/generated/manifest.json

# Reproducible demo image and its metadata.
!/inputs/demo/input.pgm
!/inputs/demo/image.hex
!/inputs/demo/image.json

# CPU dependency, license and upstream provenance.
!/third_party/picorv32/picorv32.v
!/third_party/picorv32/COPYING
!/third_party/picorv32/README.md
!/third_party/picorv32/PROVENANCE.md

# Prune generated/heavy/private directories even if they contain source files.
/build/
/reports/
/runs/
/run_inputs/
/.codex/
/.venv/
/venv/
/pdk/
/pdks/
/.volare/
**/__pycache__/
**/node_modules/
**/.pytest_cache/
**/.Xil/

# Four small, verified Shapes inputs; raw dataset and other images stay ignored.
!/inputs/shapes32_00_01/input.pgm
!/inputs/shapes32_00_01/image.hex
!/inputs/shapes32_00_01/image.json
!/inputs/shapes32_01_01/input.pgm
!/inputs/shapes32_01_01/image.hex
!/inputs/shapes32_01_01/image.json
!/inputs/shapes64_00_01/input.pgm
!/inputs/shapes64_00_01/image.hex
!/inputs/shapes64_00_01/image.json
!/inputs/shapes64_01_01/input.pgm
!/inputs/shapes64_01_01/image.hex
!/inputs/shapes64_01_01/image.json
# Small original RGB diagnostic INPUT fixtures, never generated RTL evidence.
!/inputs/rgb_smoke32_v1/image.json
!/inputs/rgb_smoke32_v1/image.hex
!/inputs/rgb_smoke32_v1/input.ppm
!/inputs/rgb_smoke32_v1/original.ppm
!/inputs/rgb_partial17x19_v1/image.json
!/inputs/rgb_partial17x19_v1/image.hex
!/inputs/rgb_partial17x19_v1/input.ppm
!/inputs/rgb_partial17x19_v1/original.ppm
